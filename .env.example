# Pages build settings. Restrict browser keys to your Pages origins.
VITE_CESIUM_TOKEN=
VITE_GOOGLE_TILES_KEY=
VITE_API_BASE=http://localhost:8787/
# Worker secrets: use worker/.dev.vars locally, wrangler secret put in production.
AISSTREAM_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Worker variables: allowed public ferry MMSIs, comma-separated
FERRY_MMSIS=
PAGES_ORIGIN=http://localhost:5173
# R2 uses the SPATIAL_DATA binding in worker/wrangler.toml.
# R2 bucket: fiji-spatial-data
# Optional Worker secret for the dedicated adsb.lol application quota.
ADSB_LOL_API_KEY=

{
  "name": "fiji-spatial-view",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run assets && vite",
    "assets": "node scripts/assets.mjs",
    "build": "npm run check && npm run assets && vite build",
    "check": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "worker:dev": "wrangler dev -c worker/wrangler.toml"
  },
  "dependencies": {
    "cesium": "^1.147.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  }
}
